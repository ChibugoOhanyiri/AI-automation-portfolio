    {
      "parameters": {
        "sendTo": "={{ $json.Email }}",
        "subject": "Your Order is Confirmed – Tasty's Restaurant",
        "message": "=<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n  <title>Order Confirmed – Tasty's Restaurant</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@400;500;600&display=swap\" rel=\"stylesheet\"/>\n</head>\n<body style=\"margin:0;padding:0;background-color:#f5f0eb;font-family:'DM Sans',sans-serif;\">\n\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f5f0eb;padding:40px 0;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;width:100%;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 8px 40px rgba(0,0,0,0.10);\">\n\n          <!-- HEADER -->\n          <tr>\n            <td style=\"background-color:#C8102E;padding:48px 40px 36px;text-align:center;\">\n              <div style=\"margin-bottom:16px;font-size:36px;\">🍽️</div>\n              <div style=\"font-family:'Playfair Display',Georgia,serif;font-size:36px;font-weight:900;color:#ffffff;letter-spacing:-1px;line-height:1.1;\">\n                Tasty's Restaurant\n              </div>\n              <div style=\"margin-top:10px;font-size:13px;font-weight:600;letter-spacing:4px;text-transform:uppercase;color:rgba(255,255,255,0.75);\">\n                Order Confirmed\n              </div>\n              <div style=\"margin:20px auto 0;width:48px;height:3px;background:rgba(255,255,255,0.4);border-radius:2px;\"></div>\n            </td>\n          </tr>\n\n          <!-- GREETING -->\n          <tr>\n            <td style=\"background:#fff7f7;padding:28px 40px;border-bottom:1px solid #f0e0e0;\">\n              <p style=\"margin:0;font-size:17px;color:#1a1a1a;line-height:1.6;\">\n                Hi <strong>{{ $json.Name }}</strong> 👋,<br/>\n                Your order has been received and is being prepared with love. Here is a summary below.\n              </p>\n            </td>\n          </tr>\n\n          <!-- ORDER DETAILS -->\n          <tr>\n            <td style=\"padding:36px 40px 0;\">\n              <div style=\"font-family:'Playfair Display',Georgia,serif;font-size:20px;font-weight:700;color:#C8102E;margin-bottom:20px;\">\n                Order Details\n              </div>\n\n              <!-- Order Type Badge -->\n              <table cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom:24px;\">\n                <tr>\n                  <td style=\"background:#C8102E;color:#fff;font-size:12px;font-weight:600;letter-spacing:3px;text-transform:uppercase;padding:6px 18px;border-radius:20px;\">\n                    {{ $json['Order Type'] }}\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Details rows -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;\">\n\n                <tr>\n                  <td style=\"padding:14px 0;border-bottom:1px solid #f2e8e8;width:42%;vertical-align:top;\">\n                    <span style=\"font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:#999;\">Items Ordered</span>\n                  </td>\n                  <td style=\"padding:14px 0;border-bottom:1px solid #f2e8e8;vertical-align:top;\">\n                    <span style=\"font-size:15px;color:#1a1a1a;font-weight:500;\">{{ $json['Order Items'] }}</span>\n                  </td>\n                </tr>\n\n                <tr>\n                  <td style=\"padding:14px 0;border-bottom:1px solid #f2e8e8;vertical-align:top;\">\n                    <span style=\"font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:#999;\">Address / Pickup Point</span>\n                  </td>\n                  <td style=\"padding:14px 0;border-bottom:1px solid #f2e8e8;vertical-align:top;\">\n                    <span style=\"font-size:15px;color:#1a1a1a;font-weight:500;\">  {{ $json.Address }}</span>\n                  </td>\n                </tr>\n\n                <tr>\n                  <td style=\"padding:14px 0;border-bottom:1px solid #f2e8e8;vertical-align:top;\">\n                    <span style=\"font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:#999;\">Date and Time</span>\n                  </td>\n                  <td style=\"padding:14px 0;border-bottom:1px solid #f2e8e8;vertical-align:top;\">\n                    <span style=\"font-size:15px;color:#1a1a1a;font-weight:500;\">{{ $json['Pickup/ Delivery Time'] }}</span>\n                  </td>\n                </tr>\n\n                <tr>\n                  <td style=\"padding:14px 0;border-bottom:1px solid #f2e8e8;vertical-align:top;\">\n                    <span style=\"font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:#999;\">Contact</span>\n                  </td>\n                  <td style=\"padding:14px 0;border-bottom:1px solid #f2e8e8;vertical-align:top;\">\n                    <span style=\"font-size:15px;color:#1a1a1a;font-weight:500;\">{{ $json.Phone }}</span>\n                  </td>\n                </tr>\n\n              </table>\n            </td>\n          </tr>\n\n          <!-- TOTAL -->\n          <tr>\n            <td style=\"padding:0 40px 36px;\">\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#fff7f7;border-radius:12px;margin-top:24px;border:1px solid #f0d8d8;\">\n                <tr>\n                  <td style=\"padding:20px 24px;\">\n                    <span style=\"font-size:13px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:#C8102E;\">Order Total</span>\n                  </td>\n                  <td style=\"padding:20px 24px;text-align:right;\">\n                    <span style=\"font-family:'Playfair Display',Georgia,serif;font-size:28px;font-weight:900;color:#C8102E;\">&#8358;{{ $json.Total }}</span>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- MESSAGE -->\n          <tr>\n            <td style=\"padding:0 40px 36px;text-align:center;\">\n              <div style=\"height:1px;background:#f0e0e0;margin-bottom:32px;\"></div>\n              <p style=\"margin:0;font-size:15px;color:#555;line-height:1.7;\">\n                Need to make a change? Give us a call and we will sort it out right away.<br/>\n                <strong style=\"color:#C8102E;\">We cannot wait to serve you! 🍴</strong>\n              </p>\n            </td>\n          </tr>\n\n          <!-- FOOTER -->\n          <tr>\n            <td style=\"background:#1a1a1a;padding:36px 40px;text-align:center;\">\n              <div style=\"font-family:'Playfair Display',Georgia,serif;font-size:22px;font-weight:700;color:#ffffff;margin-bottom:6px;\">\n                Tasty's Restaurant\n              </div>\n              <div style=\"font-size:12px;letter-spacing:3px;text-transform:uppercase;color:#C8102E;margin-bottom:20px;\">\n                Good Food. Good Vibes.\n              </div>\n              <div style=\"width:40px;height:2px;background:#C8102E;margin:0 auto 20px;border-radius:2px;\"></div>\n              <div style=\"font-size:13px;color:#aaa;line-height:2;\">\n                📍 14 Admiralty Way, Lekki Phase 1, Lagos<br/>\n                📞 +234 (0) 812 345 6789\n              </div>\n              <div style=\"margin-top:20px;\">\n                <a href=\"#\" style=\"display:inline-block;margin:0 6px;background:#C8102E;color:#fff;font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;text-decoration:none;padding:8px 16px;border-radius:20px;\">Instagram</a>\n                <a href=\"#\" style=\"display:inline-block;margin:0 6px;background:#C8102E;color:#fff;font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;text-decoration:none;padding:8px 16px;border-radius:20px;\">Facebook</a>\n                <a href=\"#\" style=\"display:inline-block;margin:0 6px;background:#C8102E;color:#fff;font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;text-decoration:none;padding:8px 16px;border-radius:20px;\">Twitter</a>\n              </div>\n              <div style=\"margin-top:24px;font-size:11px;color:#555;\">\n                2026 Tasty's Restaurant. All rights reserved.\n              </div>\n            </td>\n          </tr>\n\n        </table>\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>",
